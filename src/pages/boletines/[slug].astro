---
import { BoletinService } from "@/features/boletines";
import BoletinDetail from "@/features/boletines/presentation/components/BoletinDetail.astro";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) {
    return Astro.redirect("/boletines");
}

const service = new BoletinService();

let boletin;
try {
    boletin = await service.getBoletinDetailBySlug(slug);
} catch {
    return Astro.redirect("/boletines");
}
---

<BoletinDetail boletin={boletin} />
