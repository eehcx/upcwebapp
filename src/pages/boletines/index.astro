---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BlogCard from "@/features/boletines/presentation/components/BlogCard.astro";
import {
    POST_TYPE_OPTIONS,
    formatDate,
    postHref,
    postTypeLabel,
    primaryCategory,
} from "@/features/boletines/post-presenter";
import type {
    PostSummaryDTO,
    PostType,
} from "@/core/domain/entities/post.ts";
import { PostService } from "@/core/services";

export const prerender = false;

const PAGE_SIZE = 9;
const allowedTypes = POST_TYPE_OPTIONS.map((option) => option.value).filter(
    (value): value is PostType => Boolean(value)
);

const searchParams = Astro.url.searchParams;
const rawType = searchParams.get("type") ?? "";
const type = allowedTypes.includes(rawType as PostType)
    ? (rawType as PostType)
    : "";
const q = (searchParams.get("q") ?? "").trim();
const upcomingEvents = searchParams.get("upcomingEvents") === "true";
const rawPage = Number(searchParams.get("page") ?? "0");
const page = Number.isInteger(rawPage) && rawPage > 0 ? rawPage : 0;

function buildUrl(
    overrides: Record<string, string | number | undefined> = {}
): string {
    const values: Record<string, string | number | undefined> = {
        type,
        q,
        upcomingEvents: upcomingEvents ? "true" : "",
        ...overrides,
    };

    const params = new URLSearchParams();
    for (const [key, value] of Object.entries(values)) {
        if (value === undefined || value === null || value === "") continue;
        params.set(key, String(value));
    }

    const query = params.toString();
    return `/boletines${query ? `?${query}` : ""}`;
}

const service = new PostService();
let posts: PostSummaryDTO[] = [];
let totalPages = 0;
let totalElements = 0;
let errorMessage = "";

try {
    const result = await service.getPosts({
        type: type || undefined,
        q: q || undefined,
        upcomingEvents: upcomingEvents || undefined,
        page,
        size: PAGE_SIZE,
    });
    posts = result.content;
    totalPages = result.totalPages;
    totalElements = result.totalElements;
} catch (error) {
    errorMessage =
        error instanceof Error
            ? error.message
            : "No se pudo cargar la sala de prensa.";
}
---

<BaseLayout
    title="Boletines y sala de prensa"
    description="Noticias, eventos, convocatorias y comunicados de la Universidad Politécnica del Centro."
>
    <main class="mx-auto max-w-7xl px-6 pb-32 pt-20 lg:px-8">
        <header class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-red-700">
                Sala de prensa
            </p>
            <h1 class="mt-3 text-4xl font-semibold tracking-tight text-neutral-950 sm:text-5xl">
                Boletines
            </h1>
            <p class="mt-4 text-lg leading-8 text-neutral-600">
                Consulta las noticias, eventos, convocatorias y comunicados
                oficiales de la Universidad Politécnica del Centro.
            </p>
        </header>

        <section class="mt-10 rounded-2xl border border-neutral-200 bg-neutral-50 p-4 sm:p-5">
            <form method="get" action="/boletines" class="flex flex-col gap-3 sm:flex-row">
                {type && <input type="hidden" name="type" value={type} />}
                {upcomingEvents && (
                    <input type="hidden" name="upcomingEvents" value="true" />
                )}

                <label class="sr-only" for="buscar">Buscar publicaciones</label>
                <input
                    id="buscar"
                    name="q"
                    type="search"
                    value={q}
                    placeholder="Buscar por título o contenido"
                    class="min-w-0 flex-1 rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-red-600 focus:ring-2 focus:ring-red-100"
                />
                <button
                    type="submit"
                    class="rounded-xl bg-neutral-900 px-6 py-3 text-sm font-semibold text-white transition hover:bg-neutral-800"
                >
                    Buscar
                </button>
            </form>

            <div class="mt-4 flex flex-wrap items-center gap-2">
                {
                    POST_TYPE_OPTIONS.map((option) => {
                        const isActive = type === option.value;
                        return (
                            <a
                                href={buildUrl({
                                    type: option.value,
                                    page: undefined,
                                })}
                                aria-current={isActive ? "page" : undefined}
                                class:list={[
                                    "rounded-full border px-4 py-2 text-sm font-medium transition",
                                    isActive
                                        ? "border-neutral-900 bg-neutral-900 text-white"
                                        : "border-neutral-300 bg-white text-neutral-700 hover:border-neutral-400",
                                ]}
                            >
                                {option.label}
                            </a>
                        );
                    })
                }

                <a
                    href={buildUrl({
                        upcomingEvents: upcomingEvents ? undefined : "true",
                        page: undefined,
                    })}
                    class:list={[
                        "ml-auto rounded-full border px-4 py-2 text-sm font-medium transition",
                        upcomingEvents
                            ? "border-amber-500 bg-amber-500 text-white"
                            : "border-amber-300 bg-amber-50 text-amber-900 hover:border-amber-400",
                    ]}
                >
                    Próximos eventos
                </a>
            </div>
        </section>

        <div class="mt-8 flex items-center justify-between gap-4 text-sm text-neutral-500">
            <p>
                {totalElements}{" "}
                {totalElements === 1 ? "publicación" : "publicaciones"}
            </p>
            {(q || type || upcomingEvents) && (
                <a href="/boletines" class="font-medium text-red-700 hover:text-red-800">
                    Limpiar filtros
                </a>
            )}
        </div>

        {
            errorMessage ? (
                <div class="mt-10 rounded-2xl border border-red-200 bg-red-50 p-8 text-center">
                    <h2 class="text-lg font-semibold text-red-900">
                        No se pudo cargar la sala de prensa
                    </h2>
                    <p class="mt-2 text-sm text-red-800">{errorMessage}</p>
                </div>
            ) : posts.length === 0 ? (
                <div class="mt-10 rounded-2xl border border-dashed border-neutral-300 p-12 text-center">
                    <h2 class="text-lg font-semibold text-neutral-900">
                        Sin publicaciones
                    </h2>
                    <p class="mt-2 text-sm text-neutral-600">
                        No hay resultados para los filtros seleccionados.
                    </p>
                </div>
            ) : (
                <div class="mx-auto mt-8 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 lg:mx-0 lg:max-w-none lg:grid-cols-3">
                    {posts.map((post) => (
                        <BlogCard
                            date={formatDate(post.publishedAt || post.createdAt)}
                            category={
                                primaryCategory(post) ||
                                postTypeLabel(post.postType)
                            }
                            title={post.title}
                            description={post.excerpt ?? ""}
                            authorName={
                                post.authorName || "Dirección de Comunicación"
                            }
                            authorRole={post.authorPosition ?? ""}
                            link={postHref(post.slug)}
                        />
                    ))}
                </div>
            )
        }

        {
            totalPages > 1 && (
                <nav
                    class="mt-12 flex items-center justify-center gap-4"
                    aria-label="Paginación de publicaciones"
                >
                    {page > 0 ? (
                        <a
                            href={buildUrl({ page: page - 1 })}
                            class="rounded-lg border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-700 hover:border-neutral-400"
                        >
                            Anterior
                        </a>
                    ) : (
                        <span class="rounded-lg border border-neutral-200 px-4 py-2 text-sm text-neutral-400">
                            Anterior
                        </span>
                    )}

                    <span class="text-sm text-neutral-600">
                        Página {page + 1} de {totalPages}
                    </span>

                    {page + 1 < totalPages ? (
                        <a
                            href={buildUrl({ page: page + 1 })}
                            class="rounded-lg border border-neutral-300 px-4 py-2 text-sm font-medium text-neutral-700 hover:border-neutral-400"
                        >
                            Siguiente
                        </a>
                    ) : (
                        <span class="rounded-lg border border-neutral-200 px-4 py-2 text-sm text-neutral-400">
                            Siguiente
                        </span>
                    )}
                </nav>
            )
        }
    </main>
</BaseLayout>
