---
import BaseLayout from "@/layouts/BaseLayout.astro";
import BoletinesGrid from "@/features/boletines/presentation/components/BoletinesGrid.astro";
import { BoletinService } from "@/features/boletines";

const service = new BoletinService();
const boletines = await service.getPublishedBoletines();
---

<BaseLayout>
    <main class="mx-auto max-w-7xl px-6 lg:px-8 pt-20 pb-56">
        <h1 class="text-3xl font-bold text-neutral-900 mb-8">Boletines</h1>

        <BoletinesGrid items={boletines} />
    </main>
</BaseLayout>
