---
import { ArrowRight } from "lucide-react";

interface BoletinCtaProps {
    eyebrow?: string;
    title?: string;
    description?: string;
    linkLabel?: string;
    href?: string;
}

const {
    eyebrow = "Descubre tu próxima historia",
    title = "Dale vida a tus ideas en la UPC.",
    description = "Conoce la oferta educativa y explora tu lado creativo.",
    linkLabel = "Conocer las carreras",
    href = "/carreras"
} = Astro.props as BoletinCtaProps;
---

<div class="mt-10 bg-red-600 p-6 text-white">
    <p class="text-xs font-medium text-red-100">{eyebrow}</p>
    <h2 class="mt-3 text-xl font-semibold leading-7">{title}</h2>
    <p class="mt-4 text-sm leading-6 text-red-50">{description}</p>
    <a href={href} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold hover:underline">
        {linkLabel}
        <ArrowRight size={18} aria-hidden="true" />
    </a>
</div>
