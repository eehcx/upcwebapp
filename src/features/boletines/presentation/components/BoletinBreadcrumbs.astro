---
interface BoletinBreadcrumbsProps {
    current: string;
    sectionLabel?: string;
    sectionHref?: string;
}

const {
    current,
    sectionLabel = "Boletines",
    sectionHref = "/boletines"
} = Astro.props as BoletinBreadcrumbsProps;
---

<nav aria-label="Ruta de navegación" class="flex flex-wrap items-center gap-2 text-sm text-neutral-500">
    <a href="/" class="hover:text-red-600">Inicio</a>
    <span aria-hidden="true">/</span>
    <a href={sectionHref} class="hover:text-red-600">{sectionLabel}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page" class="min-w-0 truncate text-neutral-900" title={current}>{current}</span>
</nav>
