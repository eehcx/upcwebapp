---
interface BoletinContentProps {
    html: string;
}

const { html } = Astro.props as BoletinContentProps;
---

<article
    class="prose prose-neutral max-w-none prose-h1:text-3xl prose-h2:text-2xl prose-h3:text-xl prose-h4:text-lg prose-a:no-underline hover:prose-a:underline prose-headings:scroll-mt-28 prose-headings:text-neutral-900 prose-p:text-[17px] prose-p:leading-8 prose-p:text-gray-700 prose-li:text-[17px] prose-li:text-gray-700 prose-th:text-[17px] prose-td:text-[17px]"
    set:html={html}
></article>
